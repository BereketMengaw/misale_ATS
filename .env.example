# Supabase — Project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Telegram — @BotFather
TELEGRAM_BOT_TOKEN=

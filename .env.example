# Supabase — Project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Telegram — @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram echoes it back on every webhook call.
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Shared with the Android SMS gateway app. openssl rand -hex 32
SMS_WEBHOOK_SECRET=

# Public origin, no trailing slash. For local dev use your tunnel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (optional) ---
# Which provider answers tutors' typed questions and writes job posts.
# 'template' (the default) calls no model at all and everything still works.
AI_PROVIDER=template
# Google AI Studio → Get API key. Free tier. Only read when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Mining real conversations (optional, local only) ---
# my.telegram.org → API development tools. Only used by `npm run mine:telegram`,
# never by the app. The session it writes is full access to that account: it
# lives in .env.local, which is gitignored, and is never sent anywhere.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
